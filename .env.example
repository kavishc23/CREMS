# Copy this file to .env. Never commit the completed .env file.

# Required database settings. SQL Server requires a strong SA password.
CREMS_DB_PASSWORD=replace-with-a-strong-local-password
CREMS_DB_NAME=Crems

# Required first administrator. The password must be at least 10 characters and
# include an uppercase letter and a number.
CREMS_ADMIN_EMAIL=admin@example.com
CREMS_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CREMS_ADMIN_FULL_NAME=System Administrator

# Local addresses. Change these only if the default ports are already in use.
CREMS_API_URL=http://localhost:5080
CREMS_FRONTEND_URL=http://localhost:5173

# Email is disabled by default. For Brevo HTTPS delivery, set EMAIL_ENABLED=true,
# EMAIL_API_KEY, and EMAIL_FROM_ADDRESS. During local testing, keep a redirect.
EMAIL_ENABLED=false
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Carpenters Rentals
EMAIL_REDIRECT_ALL_TO=
EMAIL_NOTIFICATION_COPY_TO=
EMAIL_NOTIFICATION_DIRECT_DELIVERY=false
EMAIL_ALLOW_DIRECT_DELIVERY_OUTSIDE_PRODUCTION=false

# SMTP fallback. Leave blank when using the Brevo API key above.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_SSL=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

